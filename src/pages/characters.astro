---
// Página de Personagens - Good Garden Archive (GGA)

const characters = [
  {
    id: 'owl',
    name: 'OWL (Crazy)',
    role: 'Artista / Cantor Principal / O Intelectual Caótico',
    status: 'ATIVO [Ficha: Desordem Pública - 30/10/2006]',
    description: 'Inteligente, analítico e imprevisível. Owl é a voz e a mente por trás das frequências melancólicas do jardim. Suas letras navegam por estéticas urbanas e memórias fragmentadas, sempre com um plano dentro de outro plano.',
    image: '/assets/characters/owl_profile.jpg'
  },
  {
    id: 'raccoon',
    name: 'RACCOON (Core)',
    role: 'Cantor / Produtor / O Cúmplice Racional',
    status: 'INSTÁVEL [Ficha: Vadiagem e Insubordinação - 30/10/2006]',
    description: 'Ponderado, sensato e observador. Mistura batidas densas de trap/rap com melodias obscuras. Co-piloto dos experimentos sonoros, fecha as letras e constrói a atmosfera densa do núcleo.',
    image: '/assets/characters/raccoon_profile.jpg'
  },
  {
    id: 'al',
    name: 'AL',
    role: 'Produtor Musical / Engenheiro de Áudio',
    status: 'MONITORANDO [Ficha: Invasão de Frequência - 15/05/2007]',
    description: 'O arquiteto das sonoridades brutas. Controla as mixagens, os beats e a engenharia de som por trás das gravações do GGA, garantindo que o sinal nunca perca a sujeira analógica.',
    image: '/assets/characters/al_profile.jpg'
  },
  {
    id: 'xico',
    name: 'XICO (SAPO)',
    role: 'Filmmaker / Diretor Visual',
    status: 'EM CAMPO [Ficha: Registro Clandestino - 12/09/2007]',
    description: 'Responsável por capturar a essência visual e a estética lo-fi do projeto. O homem por trás das lentes que transforma a realidade urbana do submundo em registros visuais permanentes.',
    image: '/assets/characters/xico_profile.jpg'
  }
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Internet Explorer — http://good-garden-archive.sys/personagens</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>

    {/* Simulação da Janela do Navegador / Sistema */}
    <div class="browserWindow">
      
      {/* Barra de Título do Internet Explorer */}
      <div class="ieTitleBar">
        <span>Internet Explorer — http://good-garden-archive.sys/personagens</span>
        <div class="windowControls">
          <button class="controlBtn">_</button>
          <button class="controlBtn">□</button>
          <button class="controlBtn">X</button>
        </div>
      </div>

      {/* Menu Superior de Navegação do Portal */}
      <div class="navBar">
        <a href="/" class="navLink">Início</a>
        <a href="/characters" class="navLink activeTab">Personagens</a>
        <a href="/gallery" class="navLink">Galeria</a>
        <a href="/music" class="navLink">Música</a>
        <a href="/videos" class="navLink">Vídeos</a>
        <a href="/classifieds" class="navLink">Classificados</a>
        <a href="/archive" class="navLink">Arquivo</a>
        <a href="/chat" class="navLink chatLink">[ Chat IRC ]</a>
      </div>

      {/* Barra de Log do Sistema */}
      <div class="sysLog">
        [SYS_LOG] Dossiês de OWL, RACCOON, AL & XICO carregados com sucesso.
      </div>

      {/* Conteúdo Interno Estilo Diretório Windows 98 / Exploração */}
      <div class="contentArea">
        <div class="retroWindow">
          
          <div class="retroTitleBar">
            <span>📁 DIRETÓRIO_MUGSHOTS_C:\GARDEN\PROFILES</span>
            <div class="windowControls">
              <button class="controlBtn">_</button>
              <button class="controlBtn">✕</button>
            </div>
          </div>

          <div class="retroBody">
            <p class="instructions">
              Registros policiais, dossiês e mugshots confidenciais dos membros do núcleo criativo do GGA.
            </p>

            {/* Caixa estilo terminal com os perfis */}
            <div class="terminalBox">
              <div class="folderHeader">
                <span>📁 Fichas Policiais & Identificação</span>
                <span class="restrictedBadge">🔒 [CONFIDENCIAL - POLÍCIA DO SISTEMA]</span>
              </div>

              <div class="characterList">
                {characters.map((char) => (
                  <div class="charCard">
                    {/* Moldura de Mugshot Estilo Policial */}
                    <div class="charPhotoFrame">
                      <img 
                        src={char.image} 
                        alt={char.name} 
                        class="charImg" 
                        onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'110\' height=\'130\'><rect width=\'110\' height=\'130\' fill=\'%23000\'/><text x=\'50%\' y=\'50%\' fill=\'%2300ff00\' font-size=\'9\' font-family=\'monospace\' text-anchor=\'middle\' dominant-baseline=\'middle\'>MUGSHOT_PENDENTE</text></svg>'" 
                      />
                      <div class="mugshotOverlay">GGA-PD // 2006</div>
                    </div>

                    <div class="charDetails">
                      <div class="charHeaderInfo">
                        <h3 class="charName">{char.name}</h3>
                        <span class="charStatus">[{char.status}]</span>
                      </div>
                      <div class="charRole">{char.role}</div>
                      <p class="charDesc">{char.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div style="margin-top: 15px;">
              <a href="/" class="backLink">← Retornar à Área de Trabalho</a>
            </div>

          </div>
        </div>
      </div>

    </div>

    <style>
      body {
        background-color: #004e4e;
        background-image: radial-gradient(#006b6b 1px, transparent 1px);
        background-size: 8px 8px;
        margin: 0;
        padding: 20px;
        font-family: 'Tahoma', sans-serif;
        user-select: none;
      }
      .browserWindow {
        width: 950px;
        margin: 0 auto;
        background-color: #c0c0c0;
        border: 2px solid;
        border-color: #fff #404040 #404040 #fff;
        box-shadow: 4px 4px 15px rgba(0,0,0,0.6);
      }
      .ieTitleBar {
        background: linear-gradient(90deg, #000080, #1084d0);
        color: #fff;
        padding: 4px 8px;
        font-weight: bold;
        font-size: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .windowControls {
        display: flex;
        gap: 2px;
      }
      .controlBtn {
        background-color: #c0c0c0;
        border: 2px outset #fff;
        font-size: 10px;
        font-weight: bold;
        cursor: pointer;
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .navBar {
        background-color: #c0c0c0;
        border-bottom: 2px solid #808080;
        padding: 6px 10px;
        display: flex;
        gap: 15px;
        font-size: 12px;
        align-items: center;
      }
      .navLink {
        color: #000;
        text-decoration: none;
        padding: 2px 4px;
      }
      .navLink:hover {
        text-decoration: underline;
      }
      .activeTab {
        font-weight: bold;
        background-color: #000080;
        color: #fff !important;
        border: 1px dotted #fff;
      }
      .chatLink {
        color: #873C36;
        font-weight: bold;
      }
      .sysLog {
        background-color: #000;
        color: #00ff00;
        font-family: 'Courier New', monospace;
        font-size: 11px;
        padding: 4px 10px;
        text-align: right;
        border-bottom: 1px solid #404040;
      }
      .contentArea {
        padding: 20px;
        background-color: #c0c0c0;
        min-height: 400px;
      }
      .retroWindow {
        background-color: #c0c0c0;
        border: 2px solid;
        border-color: #fff #404040 #404040 #fff;
        box-shadow: inset 1px 1px #dfdfdf;
      }
      .retroTitleBar {
        background: linear-gradient(90deg, #000080, #1084d0);
        color: #fff;
        padding: 4px 8px;
        font-weight: bold;
        font-size: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .retroBody {
        padding: 15px;
      }
      .instructions {
        font-size: 11px;
        color: #404040;
        margin-top: 0;
        margin-bottom: 15px;
      }
      .terminalBox {
        background-color: #000;
        border: 2px inset #fff;
        padding: 15px;
        min-height: 250px;
        font-family: 'Courier New', monospace;
      }
      .folderHeader {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #183D28;
        color: #fff;
        padding: 6px 10px;
        font-size: 12px;
        margin-bottom: 15px;
        border: 1px inset #fff;
      }
      .restrictedBadge {
        font-size: 10px;
        color: #ffaaaa;
      }
      .characterList {
        display: flex;
        flex-direction: column;
        gap: 15px;
      }
      .charCard {
        background: #0c0f0c;
        border: 1px inset #183D28;
        padding: 12px;
        display: flex;
        gap: 15px;
        align-items: flex-start;
      }
      .charPhotoFrame {
        width: 110px;
        height: 130px;
        background: #000;
        border: 1px solid #183D28;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
      }
      .charImg {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(100%) contrast(130%);
      }
      .mugshotOverlay {
        position: absolute;
        bottom: 2px;
        left: 2px;
        right: 2px;
        background: rgba(0, 0, 0, 0.85);
        color: #00ff00;
        font-size: 8px;
        text-align: center;
        padding: 1px 0;
        border-top: 1px dashed #00ff00;
      }
      .charDetails {
        display: flex;
        flex-direction: column;
        gap: 5px;
        flex-grow: 1;
      }
      .charHeaderInfo {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .charName {
        font-size: 14px;
        color: #fff;
        margin: 0;
        font-weight: bold;
      }
      .charStatus {
        font-size: 10px;
        color: #873C36;
      }
      .charRole {
        font-size: 11px;
        color: #A49B86;
      }
      .charDesc {
        font-size: 11px;
        color: #00ff00;
        margin: 5px 0 0 0;
        line-height: 1.4;
      }
      .backLink {
        font-family: 'Courier New', monospace;
        font-size: 12px;
        color: #000;
        text-decoration: underline;
      }
      .backLink:hover {
        color: #000080;
      }
    </style>
  </body>
</html>