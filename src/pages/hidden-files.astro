---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindowBox from '../components/WindowBox.astro';
import PixelDivider from '../components/PixelDivider.astro';
---
<BaseLayout title="[ ACESSO RESTRITO ]">
  <WindowBox title="DIRETÓRIO_OCULTO_SEC_01">
    <div style="text-align: center; padding: 20px;">
      <h2 style="font-family: var(--font-pixel); color: var(--color-rust); margin-top: 0;">ACESSO CONCEDIDO</h2>
      <p style="font-family: var(--font-pixel); font-size: 12px; color: var(--color-dust);">
        Você decodificou o sinal. O arquivo abaixo foi recuperado do perímetro.
      </p>
      
      <div style="background-color: #040504; border: 1px inset var(--color-rust); padding: 15px; margin: 20px 0; text-align: left;">
        <p style="font-family: var(--font-pixel); font-size: 11px; color: var(--color-garden-green);">
          LOG DE RECUPERAÇÃO #086:<br/>
          "Eles tentaram apagar os registros da leste, mas o servidor secundário guardou o cache. O jardim não esquece quem pisa nas folhas secas."
        </p>
      </div>

      <PixelDivider />
      
      <a href="/classifieds" style="font-family: var(--font-pixel); font-size: 12px; color: var(--color-rust);">
        [ &lt;&lt; Desconectar e retornar ao mural ]
      </a>
    </div>
  </WindowBox>
</BaseLayout>